# Copy to .env and fill in real IDs. Any variable left empty is skipped —
# dataLayer events, UTM capture and console logging work regardless.

# Google Tag Manager container (preferred route — wire GA4/Pixel tags inside GTM
# to the `page_view` and `generate_lead` dataLayer events)
VITE_GTM_ID=GTM-XXXXXXX

# Direct install (used when not going through GTM)
VITE_META_PIXEL_ID=1234567890123456
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-123456789
VITE_GOOGLE_ADS_LABEL=AbCdEfGhIjKlMnOp
